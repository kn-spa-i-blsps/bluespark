#!/usr/bin/env bash
# =============================================================================
# bs — BlueSpark bench control. Run on the governer Pi, from the repo folder:
#
#   ./bs start                 start the stack (no mission), wait until ready
#   ./bs sim                   the same, against the simulation (ArduSub SITL in
#                              Gazebo, repo bluespark-simulation) instead of the Pixhawk
#   ./bs mission <name>        run a mission with full logs; Ctrl+C = stop it safely
#   ./bs stop                  disarm and stop everything
#   ./bs disarm                EMERGENCY: disarm + all thrusters 1500
#   ./bs status                Pixhawk / armed / mode / thrusters / nodes
#   ./bs test                  check the whole chain step by step (thrusters spin)
#
#   ./bs help                  everything else (arm, althold, pwm, logs, shell, ...)
#   User guide: BENCH.md
#
# Logs: logs/<session>/ (one session = from ./bs start to ./bs stop)
#   <session> = date_time, with _sim at the end for ./bs sim sessions
#   timeline.log               everything, in order, from all nodes
#   NN_HH-MM-SS_<mission>/     one folder per mission run (info.txt, console.log, bag/)
#
# This script only calls docker compose / docker exec. The logic lives in
# src/bluespark_bringup (mission_runner, vehicle, timeline_recorder, launch files).
# =============================================================================
set -uo pipefail

REPO="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
cd "$REPO" || exit 1

COMPOSE=(docker compose -f docker-compose.bench.yml)
CONTAINER=bluespark_bench
LOGS=logs
CURRENT="$LOGS/.current"   # path of the running session, e.g. logs/2026-11-23_21-10-00
START_TIMEOUT=600          # s: colcon build
READY_TIMEOUT=60           # s: after the build: mavros + Pixhawk + control nodes

# Simulation (./bs sim): Gazebo + ArduSub SITL run in the bs_sim container
# (repo bluespark-simulation, started by hand there); its MAVProxy forwards
# MAVLink to udp 14550 on this machine, where mavros listens.
SIM_CONTAINER=bs_sim
SIM_FCU_URL="udp://:14550@"
SIM_PORT=14550

if [ -t 1 ]; then
    BOLD=$'\e[1m'; GREEN=$'\e[32m'; RED=$'\e[31m'; YELLOW=$'\e[33m'; RESET=$'\e[0m'
else
    BOLD=; GREEN=; RED=; YELLOW=; RESET=
fi
ok()   { echo "${GREEN}[ OK ]${RESET} $*"; }
fail() { echo "${RED}[FAIL]${RESET} $*"; }
warn() { echo "${YELLOW}[WARN]${RESET} $*"; }
say()  { echo "${BOLD}$*${RESET}"; }

running() { [ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null)" = "true" ]; }
session() { [ -f "$CURRENT" ] && cat "$CURRENT"; }
# mode_of <session dir>: "sim" or "hw" (Pixhawk). Sessions from before ./bs sim
# existed have no mode line: they were hw.
mode_of() {
    local m; m="$([ -n "$1" ] && sed -n 's/^mode *\([a-z]*\).*/\1/p' "$1/session_info.txt" 2>/dev/null)"
    echo "${m:-hw}"
}
session_mode() { mode_of "$(session)"; }   # mode of the current session
# Tag shown next to a session in ./bs logs / status: "[SIM]" or nothing.
mode_tag() { [ "$(mode_of "$1")" = sim ] && echo "${YELLOW}[SIM]${RESET}"; }
need_running() {
    running && return 0
    fail "The stack is not running. Start it with: ./bs start   (simulation: ./bs sim)"
    exit 1
}

# Run a command inside the container with ROS sourced.
in_ros() {
    local opts=()
    [ -t 0 ] && [ -t 1 ] && opts+=(-it)
    local s; s="$(session)"
    [ -n "$s" ] && opts+=(-e "BS_SESSION_DIR=/workspace/$s")
    docker exec "${opts[@]}" "$CONTAINER" bash -c \
        'source /opt/ros/jazzy/setup.bash && source /workspace/install/setup.bash && exec "$@"' _ "$@"
}

# Run a bluespark_bringup program (vehicle, mission_runner) inside the container.
# Same as `ros2 run bluespark_bringup <exe>`, without the extra
# "[ros2run]: Process exited with failure" line and without a wrapper process.
bringup() {
    in_ros bash -c 'exec "$(ros2 pkg prefix bluespark_bringup)/lib/bluespark_bringup/$0" "$@"' "$@"
}

# ----------------------------------------------------------------------------
# Before ./bs sim: is the simulation up and is mavros' UDP port free?
# Fails fast with what to do, instead of a mavros timeout 30 s later.
sim_preflight() {
    if [ "$(docker inspect -f '{{.State.Running}}' "$SIM_CONTAINER" 2>/dev/null)" != "true" ]; then
        fail "The simulation container ($SIM_CONTAINER) is not running."
        echo "In the bluespark-simulation repo: ./start_docker.sh, then (README there):"
        echo "  terminal 1: bash scripts/run_gazebo.sh"
        echo "  terminal 2: bash scripts/run_ardusub.sh     (wait for MANUAL>)"
        return 1
    fi
    if ! docker exec "$SIM_CONTAINER" pgrep -f "gz sim" >/dev/null 2>&1; then
        fail "Gazebo is not running in $SIM_CONTAINER."
        echo "Start it first, in $SIM_CONTAINER:"
        echo "  terminal 1: bash scripts/run_gazebo.sh"
        echo "  terminal 2: bash scripts/run_ardusub.sh     (wait for MANUAL>)"
        return 1
    fi
    if ! docker exec "$SIM_CONTAINER" pgrep -x ardusub >/dev/null 2>&1 \
        || ! docker exec "$SIM_CONTAINER" pgrep -f mavproxy.py >/dev/null 2>&1; then
        fail "ArduSub SITL / MAVProxy is not running in $SIM_CONTAINER."
        echo "Start it (in $SIM_CONTAINER, Gazebo already running): bash scripts/run_ardusub.sh"
        echo "and wait for the MANUAL> prompt."
        return 1
    fi
    if command -v ss >/dev/null && [ -n "$(ss -Hlun "sport = :$SIM_PORT" 2>/dev/null)" ]; then
        fail "UDP port $SIM_PORT is already in use: probably another mavros"
        echo "(e.g. a 'ros2 launch ... governer.launch.py' in the dev container). Stop it first."
        return 1
    fi
    ok "Simulation is up: Gazebo + ArduSub SITL in $SIM_CONTAINER"
}

# cmd_start [hw|sim]: hw = Pixhawk on USB (./bs start), sim = ArduSub SITL (./bs sim).
cmd_start() {
    local mode="${1:-hw}"
    if running; then
        ok "Already running ($(mode_name "$(session_mode)")). Session: $(session)/"
        if [ "$(session_mode)" != "$mode" ]; then
            warn "You asked for $(mode_name "$mode"). Switch with: ./bs stop && ./bs $( [ "$mode" = sim ] && echo sim || echo start )"
            return 1
        fi
        return 0
    fi
    local fcu=""
    if [ "$mode" = sim ]; then
        sim_preflight || return 1
        fcu="$SIM_FCU_URL"
    else
        # Another BlueSpark container (e.g. prod: bluespark_governer) would fight
        # over the Pixhawk's serial port with ours.
        local others
        others="$(docker ps --format '{{.Names}}' | grep '^bluespark_' | grep -vx "$CONTAINER")"
        if [ -n "$others" ]; then
            fail "Another BlueSpark container is running: $others"
            echo "Stop it first, e.g.: docker compose -f docker-compose.prod.yml down"
            return 1
        fi
    fi
    mkdir -p "$LOGS"
    local s; s="$LOGS/$(date +%Y-%m-%d_%H-%M-%S)"
    [ "$mode" = sim ] && s+="_sim"   # visible in ls logs/ and when copied off the Pi
    mkdir -p "$s" && echo "$s" > "$CURRENT"
    {
        echo "started   $(date '+%Y-%m-%d %H:%M:%S')"
        echo "host      $(hostname)"
        echo "mode      $mode  ($(mode_name "$mode")${fcu:+, fcu_url $fcu})"
        echo "git       $(git rev-parse --short HEAD 2>/dev/null) on $(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
        git status --porcelain 2>/dev/null | sed 's/^/changed  /'
    } > "$s/session_info.txt"

    say "Starting the stack ($(mode_name "$mode")). Session logs: $s/"
    # FCU_URL is always set (empty = Pixhawk default of governer.launch.py), so a
    # FCU_URL exported in your shell cannot silently change what ./bs start does.
    FCU_URL="$fcu" BS_SESSION_DIR="/workspace/$s" "${COMPOSE[@]}" up -d >/dev/null || {
        fail "docker compose up failed (see the error above)"
        return 1
    }
    follow_start "$mode"
}

mode_name() { [ "$1" = sim ] && echo "SIMULATION, ArduSub SITL" || echo "Pixhawk"; }

# Wait for the build (container log), then for the stack itself (vehicle ready):
# the launch starts every node at once, so readiness is checked from outside.
follow_start() {
    local mode="$1" fc="Pixhawk"
    [ "$mode" = sim ] && fc="ArduSub SITL"
    local since; since="$(docker inspect -f '{{.State.StartedAt}}' "$CONTAINER")"
    local t0=$SECONDS log=""
    say "Building the workspace (colcon)..."
    while :; do
        log="$(docker logs --since "$since" "$CONTAINER" 2>&1)"
        if grep -q "^Summary: .* finished" <<<"$log"; then
            ok "Workspace built"
            break
        fi
        if grep -qE "Failed +<<<|Aborted +<<<" <<<"$log"; then
            fail "The code does not build:"
            grep -E "Failed|Aborted|Error|error:" <<<"$log" | tail -15
            echo "Full log: docker logs $CONTAINER"
            return 1
        fi
        if ! running; then
            fail "The container stopped:"
            tail -8 <<<"$log"
            echo "Full log: docker logs $CONTAINER"
            return 1
        fi
        if (( SECONDS - t0 > START_TIMEOUT )); then
            fail "Not built after ${START_TIMEOUT} s. See: docker logs $CONTAINER"
            return 1
        fi
        sleep 1
    done

    say "Waiting for mavros, the $fc and the control nodes (up to ${READY_TIMEOUT} s)..."
    local out rc
    # pipefail (set at the top): rc is vehicle's exit code, not tee's.
    out="$(bringup vehicle ready --timeout "$READY_TIMEOUT" | tee /dev/stderr)"
    rc=$?
    if [ "$rc" -eq 0 ]; then
        echo
        [ "$mode" = sim ] && say "SIMULATION: watch the vehicle in Gazebo."
        say "READY.  Next: ./bs test   or   ./bs mission <name>   (./bs missions lists them)"
        say "        Manual: ./bs arm | ./bs althold | ./bs pwm surge 1600 | ./bs disarm"
        return 0
    fi
    fail "The stack did not come up."
    if ! running; then
        echo "The container stopped:"
        docker logs --since "$since" "$CONTAINER" 2>&1 | grep -E "ERROR|Error|exception" | tail -8
    elif grep -q "FAIL.*Flight controller connected" <<<"$out"; then
        echo
        if [ "$mode" = sim ]; then
            say "No MAVLink from ArduSub SITL. In $SIM_CONTAINER: is run_ardusub.sh"
            say "at the MANUAL> prompt? Restarted ArduSub? Then: ./bs stop && ./bs sim"
        else
            say "No Pixhawk. Check the USB cable and power, then: ls /dev/ttyACM*"
            say "Then: ./bs stop && ./bs start"
        fi
    fi
    echo "Full log: docker logs $CONTAINER"
    return 1
}

cmd_stop() {
    if running; then
        say "Disarming..."
        bringup vehicle disarm || warn "Could not confirm the disarm, check the vehicle!"
    fi
    say "Stopping the stack..."
    "${COMPOSE[@]}" down >/dev/null 2>&1
    ok "Stopped"
    local s; s="$(session)"
    [ -n "$s" ] && echo "Session logs: $s/"
    [ "$(session_mode)" = sim ] && echo "Gazebo and ArduSub SITL keep running in $SIM_CONTAINER."
    rm -f "$CURRENT"
}

# Restart in the same mode as the current session (sim stays sim).
cmd_restart() { local m; m="$(session_mode)"; cmd_stop; echo; cmd_start "$m"; }

cmd_mission() {
    need_running
    if [ $# -lt 1 ]; then
        echo "Usage: ./bs mission <name> [arguments for the mission]"
        cmd_missions
        return 1
    fi
    bringup mission_runner "$@"
}

cmd_missions() {
    echo "Missions:"
    if running; then
        in_ros ros2 pkg executables bluespark_autonomy | awk '{print "  " $2}'
    else   # from the source, without the container
        sed -n "/console_scripts/,/]/p" src/bluespark_autonomy/setup.py \
            | grep -oE "'[A-Za-z0-9_]+ *=" | tr -d "' =" | sed 's/^/  /'
    fi
}

cmd_vehicle() { need_running; bringup vehicle "$@"; }

cmd_disarm() {
    if ! running; then
        fail "The stack is not running, nothing to disarm through. Use the kill switch if needed."
        return 1
    fi
    bringup vehicle disarm
}

cmd_status() {
    if ! running; then
        say "Stack: NOT running   (./bs start, simulation: ./bs sim)"
        local last; last="$(ls -d "$LOGS"/20*/ 2>/dev/null | tail -1)"
        [ -n "$last" ] && echo "Last session: $last $(mode_tag "${last%/}")"
        return 1
    fi
    say "Stack: running ($(mode_name "$(session_mode)")).  Session: $(session)/"
    bringup vehicle status
    local rc=$?
    local s; s="$(session)"
    if [ -n "$s" ] && [ -f "$s/timeline.log" ]; then
        echo
        say "Last events (./bs logs -f to follow):"
        tail -n 8 "$s/timeline.log"
    fi
    return $rc
}

cmd_logs() {
    local s; s="$(session)"
    [ -z "$s" ] && s="$(ls -d "$LOGS"/20*/ 2>/dev/null | tail -1)"
    s="${s%/}"
    if [ -z "$s" ]; then
        echo "No sessions in $LOGS/ yet."
        return 1
    fi
    if [ "${1:-}" = "-f" ]; then
        tail -n 30 -f "$s/timeline.log"
        return
    fi
    say "Session: $s/ $(mode_tag "$s")"
    local run res
    for run in "$s"/[0-9][0-9]_*/; do
        [ -d "$run" ] || continue
        res="$(sed -n 's/^result *//p' "$run/info.txt" 2>/dev/null)"
        printf "  %-45s %s\n" "$(basename "$run")" "${res:-?}"
    done
    echo
    echo "  timeline:   $s/timeline.log      (./bs logs -f to follow it live)"
    echo "  all:        ls $LOGS/      (simulation sessions end with _sim)"
}

cmd_shell() {
    need_running
    echo "Inside the container (ROS sourced). Exit with Ctrl+D."
    docker exec -it "$CONTAINER" bash
}

cmd_help() {
    cat <<EOF
${BOLD}BlueSpark bench control${RESET}   (run on the governer Pi, in the repo folder)

${BOLD}Main${RESET}
  ./bs start                 start the stack (no mission), waits until ready
  ./bs sim                   the same against the simulation (ArduSub SITL in Gazebo,
                             container $SIM_CONTAINER; start Gazebo + ArduSub there first)
  ./bs mission <name>        run a mission with full logs; Ctrl+C = stop it safely
  ./bs stop                  disarm and stop everything
  ./bs disarm                EMERGENCY: disarm + all thrusters 1500
  ./bs status                Pixhawk / armed / mode / thrusters / nodes + last events
  ./bs test                  whole chain step by step: nodes, Pixhawk, MANUAL, arm,
                             each thruster axis 1600 for 2 s, ALT_HOLD, disarm (THRUSTERS SPIN)

${BOLD}Manual control${RESET} (stack running)
  ./bs arm                   arm (answer from the Pixhawk)
  ./bs althold               mode ALT_HOLD (hold depth); back with: ./bs mode MANUAL
  ./bs mode <MODE>           MANUAL, STABILIZE, ALT_HOLD, ...
  ./bs pwm <axis> <value>    axis: pitch roll heave yaw surge sway, 1100-1900, 1500 = stop
  ./bs neutral               all thrusters 1500

${BOLD}Other${RESET}
  ./bs missions              list missions
  ./bs logs                  runs of the current/last session with their result
  ./bs logs -f               follow the session timeline live
  ./bs restart               stop + start (in the same mode: sim stays sim)
  ./bs shell                 shell inside the container (plan B: ros2 ... by hand)

${BOLD}Logs${RESET}: $LOGS/<session>/timeline.log and $LOGS/<session>/NN_<time>_<mission>/
      (<session> ends with _sim for ./bs sim)
Guide: BENCH.md
Copy to a laptop: scp -r <user>@<pi>:$(pwd)/$LOGS/<session> .
EOF
}

# ----------------------------------------------------------------------------
cmd="${1:-help}"
shift || true
case "$cmd" in
    start)    cmd_start hw ;;
    sim)      cmd_start sim ;;
    stop)     cmd_stop ;;
    restart)  cmd_restart ;;
    mission)  cmd_mission "$@" ;;
    missions) cmd_missions ;;
    disarm)   cmd_disarm ;;
    arm|mode|pwm|neutral|test) cmd_vehicle "$cmd" "$@" ;;
    althold)  cmd_vehicle mode ALT_HOLD ;;
    status)   cmd_status ;;
    logs)     cmd_logs "$@" ;;
    shell)    cmd_shell ;;
    help|-h|--help) cmd_help ;;
    *)        fail "Unknown command: $cmd"; echo; cmd_help; exit 1 ;;
esac
