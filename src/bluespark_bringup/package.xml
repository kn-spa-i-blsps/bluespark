<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>bluespark_bringup</name>
    <version>0.0.0</version>
    <description>Launch files that bring up the BlueSpark system per Raspberry Pi role (front / down / side / brain).</description>
    <maintainer email="jappa414@gmail.com">jappa</maintainer>
    <license>TODO: License declaration</license>

    <!-- Runtime dependencies: the packages whose nodes these launch files start.
         exec_depend = needed to run, not to compile. -->
    <exec_depend>bluespark_vision</exec_depend>
    <exec_depend>bluespark_control</exec_depend>
    <exec_depend>bluespark_autonomy</exec_depend>
    <exec_depend>mavros</exec_depend>
    <exec_depend>ros2launch</exec_depend>

    <test_depend>ament_copyright</test_depend>
    <test_depend>ament_flake8</test_depend>
    <test_depend>ament_pep257</test_depend>
    <test_depend>python3-pytest</test_depend>

    <export>
        <build_type>ament_python</build_type>
    </export>
</package>
