<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="Untitled">
    <SequenceWithMemory>
      <Sequence>
        <Fallback name="Gate Finding">
          <ScriptCondition code="Gate visible?"/>
          <SearchForObject target="Gate"/>
        </Fallback>
        <Fallback name="Match gate depth">
          <ScriptCondition code="At gate depth?"/>
          <Timeout msec="">
            <AdjustDepth/>
          </Timeout>
        </Fallback>
        <Timeout msec="">
          <ApproachObject target="Gate"/>
        </Timeout>
        <Timeout msec="">
          <OrbitObject target="Gate"/>
        </Timeout>
        <GoForward/>
      </Sequence>
      <Sequence>
        <Fallback name="Pole Finding">
          <ScriptCondition code="Pole visible?"/>
          <SearchForObject target="Pole"/>
        </Fallback>
        <Fallback name="Match pole depth">
          <ScriptCondition code="At pole depth"/>
          <Timeout msec="">
            <AdjustDepth/>
          </Timeout>
        </Fallback>
        <ApproachObject target="Pole"/>
        <Timeout msec="">
          <OrbitObject target="Pole"/>
        </Timeout>
      </Sequence>
    </SequenceWithMemory>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AdjustDepth"
            editable="true"/>
    <Action ID="ApproachObject"
            editable="true">
      <input_port name="target"
                  type="String"/>
    </Action>
    <Action ID="GoForward"
            editable="true"/>
    <Action ID="OrbitObject"
            editable="true">
      <input_port name="target"
                  type="String"/>
    </Action>
    <Action ID="SearchForObject"
            editable="true">
      <input_port name="target"
                  type="String"/>
    </Action>
  </TreeNodesModel>

</root>
