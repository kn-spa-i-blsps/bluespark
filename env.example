# Copy to .env on each Raspberry Pi and set that Pi's role.
# .env is per-machine and NOT committed (see .gitignore).
#
#   cp .env.example .env      # then edit the line below
#
# Roles:
#   front  -> front camera  + YOLO         (ros2 launch front.launch.py)
#   down   -> bottom camera + pipeline/path_marker/bin  (down.launch.py)
#   side   -> side camera   + YOLO         (side.launch.py)
#   governer  -> control + autonomy        (run_governer.sh -> governer.launch.py)

WHICH_RPI=down
